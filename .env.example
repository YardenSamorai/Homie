# Copy to .env.local and fill in from the Supabase project "homie" (Project Settings → API).
# Then run supabase/migrations/0001_v1.sql once in the SQL editor.
# While these are empty, sign-in stays the demo code 123456.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sorts shopping items the built-in dictionary doesn't know into aisles. Without it they wait under "other".
# Server only; OPENAI_MODEL is optional (default gpt-4.1-mini).
OPENAI_API_KEY=
OPENAI_MODEL=
