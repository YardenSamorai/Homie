# Copy to .env.local and fill in from the Supabase project "homie" (Project Settings → API).
# Then run supabase/migrations/0001_v1.sql once in the SQL editor.
# While these are empty, sign-in stays the demo code 123456.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sorts shopping items the built-in dictionary doesn't know into aisles. Without it they wait under "other".
# Server only; OPENAI_MODEL is optional (default gpt-4.1-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# Connected calendars (read-only). Setup steps: docs/CALENDARS.md. Server only; never NEXT_PUBLIC_.
# Until the service role key and CALENDAR_TOKEN_KEY are set, the connect buttons stay off.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32. Seals provider tokens; changing it asks every account to reconnect.
CALENDAR_TOKEN_KEY=
# Optional. The public site origin the redirect URIs are registered under; defaults to the request's origin.
CALENDAR_REDIRECT_ORIGIN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional. "common" (default) accepts work, school and personal Microsoft accounts.
MICROSOFT_CALENDAR_TENANT=
# Shared with the morning summary; the calendar cron (/api/cron/calendars) checks it too.
CRON_SECRET=
